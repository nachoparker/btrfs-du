#!/bin/bash
# Disable history expansion for ! and so
set +H
# exit if any uninitialized variable is used to prevent mistakes on rm and so
set -u
# exit immediately if any command exits with a non-zero status
set -e

#
# Script that outputs the filesystem usage of snapshots in a location ( root if omited )
#
# Usage:
#          sudo btrfs-du ( path )
#
# Copyleft 2017 by Ignacio Nunez Hernanz <nacho _a_t_ ownyourbits _d_o_t_ com>
# GPL licensed (see end of file) * Use at your own risk!
#
# Contributors: Jeroen Wiert Pluimers (jpluimers)
#
# Based on btrfs-size by Kyle Agronick
#
# More at https://ownyourbits.com/2017/12/06/check-disk-space-of-your-btrfs-snapshots-with-btrfs-du/
#

# bytesToHumanIEC based on https://unix.stackexchange.com/questions/44040/a-standard-tool-to-convert-a-byte-count-into-human-kib-mib-etc-like-du-ls1/259254#259254
# both bytesToHumanIEC, an SI implementatation and test cases for both are at https://gist.github.com/jpluimers/0f21bf1d937fe0b9b4044f21944a90ec

bytesToHumanIEC() {
    if [ "$RAW_NUMBERS" = "1" ]; then
        echo "${1}"
    elif [ -n "$UNIT" ]; then
        b=${1:-0}
        case "$UNIT" in
            k) d=$(( b % 1024 * 100 / 1024 )); printf "%d.%02dKiB" "$(( b / 1024 ))" "$d" ;;
            m) d=$(( b % 1048576 * 100 / 1048576 )); printf "%d.%02dMiB" "$(( b / 1048576 ))" "$d" ;;
            g) d=$(( b % 1073741824 * 100 / 1073741824 )); printf "%d.%02dGiB" "$(( b / 1073741824 ))" "$d" ;;
            t) d=$(( b % 1099511627776 * 100 / 1099511627776 )); printf "%d.%02dTiB" "$(( b / 1099511627776 ))" "$d" ;;
        esac
    else
        b=${1:-0}; d=''; s=0; S=(Bytes {K,M,G,T,E,P,Z,Y}iB)
        while ((b > 1024)); do
            d="$(printf ".%02d" $((b % 1024 * 100 / 1024)))"
            b=$((b / 1024))
            let s++
        done
        echo "$b$d${S[$s]}"
    fi
}

BTRFS_OPT=""
RAW_NUMBERS=""
UNIT=""
SORT_BY=""
LOCATION="/"
TOT=()
EXC=()
NAME=()
TOT_RAW=()
EXC_RAW=()

while [ ${#} -gt 0 ]; do
  case "${1}" in
      -h|--help)
          echo -en "btrfs-du [-o] [-b] [-s <sort>] [-k|-m|-g|-t] <PATH_to_BTRFS-mount>\n\n"
          echo -en "-o\t\tprint only subvolumes below specified path\n"
          echo -en "-b\t\tprint numbers raw (in bytes)\n"
          echo -en "-s <sort>\tsort by SubvolumeName, Total, Exclusive, or ID\n"
          echo -en "\t\tmultiple sorts separated by comma, e.g. -s Exclusive,Total\n"
          echo -en "-k\t\tshow sizes in KiB\n"
          echo -en "-m\t\tshow sizes in MiB\n"
          echo -en "-g\t\tshow sizes in GiB\n"
          echo -en "-t\t\tshow sizes in TiB\n"
          echo -en "-h\t\tprint help\n"
          exit 0
          ;;
      -o)
          BTRFS_OPT=" -o "
          shift
          ;;
      -b)
          RAW_NUMBERS="1"
          shift
          ;;
      -s)
          SORT_BY="${2:-}"
          shift 2
          ;;
      -k)
          UNIT="k"
          shift
          ;;
      -m)
          UNIT="m"
          shift
          ;;
      -g)
          UNIT="g"
          shift
          ;;
      -t)
          UNIT="t"
          shift
          ;;
      *)
        LOCATION=${1:-/}
        shift
        ;;
  esac
done

# validate options
if [[ "$RAW_NUMBERS" == "1" && -n "$UNIT" ]]; then
  echo "Error: -b cannot be combined with -k, -m, -g, or -t"
  exit 1
fi

if [[ -n "$SORT_BY" ]]; then
  IFS=',' read -ra SORT_OPTIONS <<< "$SORT_BY"
  for opt in "${SORT_OPTIONS[@]}"; do
    case "$opt" in
      SubvolumeName|Total|Exclusive|ID) ;;
      *)
        echo "Error: invalid sort option '$opt'. Use SubvolumeName, Total, Exclusive, or ID"
        exit 1
        ;;
    esac
  done
else
  SORT_OPTIONS=()
fi

# checks
[[ ${EUID} -ne 0 ]] && {
  printf "Must be run as root. Try 'sudo $( basename "$0" )'\n"
  exit 1
}

[[ -d "$LOCATION" ]] || {
  echo "$LOCATION not found"
  exit 1
}

[[ "$( stat -fc%T "$LOCATION" )" != "btrfs" ]] && {
  echo "$LOCATION is not in a BTRFS system"
  exit 1
}

# determine if the '--raw' option is supported:
btrfs_qgroup_show_raw="btrfs qgroup show --raw"

OUT=$( $btrfs_qgroup_show_raw "$LOCATION" 2>&1 ) || true

grep -i -q -e "no such file or directory" <<< "$OUT" && {
  echo "old btrfs-tools detected, need to enable quota and wait for rescan to display accurate results"
  exit 1
}

grep -q -e "unrecognized option" <<< "$OUT" && {
  echo "INFO: Legacy btrfs version; trying 'btrfs qgroup show' without '--raw'..."
  # not supported by "Btrfs v3.12+20131125" and likekly other legacy versions
  # luckily "Btrfs v3.12+20131125" gives the same output without '--raw'
  # as "btrfs-progs v4.13.3" does with '--raw'
  btrfs_qgroup_show_raw="btrfs qgroup show"
}

# quota management
QFLAG=0
cleanup() {
  [[ "$QFLAG" == "1" ]] && btrfs quota disable "$LOCATION"
}
trap cleanup EXIT
sync
btrfs qgroup show "$LOCATION" 2>&1 | grep -q "quotas not enabled" && {
  QFLAG=1
  btrfs quota enable "$LOCATION"
}

# if we just enabled quota, might have to wait for rescan using 'btrfs qgroup show'

OUT=$( $btrfs_qgroup_show_raw "$LOCATION" 2>&1 ) || true
grep -i -q -e "rescan is running" -e "data inconsistent" <<< "$OUT" && {
  echo "INFO: Quota is disabled. Waiting for rescan to finish ..."
  while true; do
    sleep 2
    OUT=$( $btrfs_qgroup_show_raw "$LOCATION" 2>&1 ) || true
    grep -i -q -e "rescan is running" -e "data inconsistent" <<< "$OUT" || break
  done
}

# data

## qgroup data
OUT=$( sed '1,3d' <<< "$OUT" )
ID__=( $( awk '$1 ~ /^[0-9]+\// { split($1, a, "/"); print a[2] }' <<< "$OUT" ) )
TOT_=( $( awk '$1 ~ /^[0-9]+\// { print $2 }' <<< "$OUT" ) )
EXC_=( $( awk '$1 ~ /^[0-9]+\// { print $3 }' <<< "$OUT" ) )

EXC_RAW=()
TOT_RAW=()
for (( i = 0 ; i < ${#ID__[@]} ; i++ )); do
  id=${ID__[$i]}
  TOT_RAW[$id]=${TOT_[$i]:-0}
  EXC_RAW[$id]=${EXC_[$i]:-0}
  TOT[$id]=$( bytesToHumanIEC "${TOT_[$i]:-0}" )
  EXC[$id]=$( bytesToHumanIEC "${EXC_[$i]:-0}" )
done

## naming data
OUT=$( btrfs subvolume list -t --sort=rootid ${BTRFS_OPT} "$LOCATION"| tail -n +3 )
ID__=( $( awk -F "\t" '{ print $1 }' <<< "$OUT" ) )
NAM_=( $( awk -F "\t" '{ print $5 }' <<< "$OUT" ) )

for (( i = 0 ; i < ${#ID__[@]} ; i++ )); do
  NAME[${ID__[$i]}]=${NAM_[$i]}
done

formatMask="%-60s %10s %10s  %-10s\n"
separatorLine="─────────────────────────────────────────────────────────────────────────────────────────\n"

print_report() {
  local sort_key="${1:-}"

  # sort IDs if requested
  if [ -n "$sort_key" ]; then
    SORT_INPUT=""
    for (( i = 0 ; i < ${#ID__[@]} ; i++ )); do
      id=${ID__[$i]}
      case "$sort_key" in
        SubvolumeName) key="${NAME[$id]:-}" ;;
        Total)         key=$(printf "%020d" "${TOT_RAW[$id]:-0}") ;;
        Exclusive)     key=$(printf "%020d" "${EXC_RAW[$id]:-0}") ;;
        ID)            key=$(printf "%020d" "$id") ;;
      esac
      SORT_INPUT+="${key} ${id}"$'\n'
    done
    mapfile -t SORTED_IDS < <(sort <<< "$SORT_INPUT" | awk 'NF{print $NF}')
  else
    SORTED_IDS=("${ID__[@]}")
  fi

  EXCL_TOTAL=0

  printf "\n"
  if [ -n "$sort_key" ]; then
    printf "Sort: %s\n" "$sort_key"
  fi
  printf "$formatMask" "Subvolume" "Total" "Exclusive" "ID"
  printf "$separatorLine"

  for (( i = 0 ; i < ${#SORTED_IDS[@]} ; i++ )); do
    id=${SORTED_IDS[$i]}
    [[ -z "${NAME[$id]:-}" ]] && continue
    printf "$formatMask" "${NAME[$id]:-}" "${TOT[$id]:-0}" "${EXC[$id]:-0}" "$id"
    EXCL_TOTAL=$(( EXCL_TOTAL + ${EXC_RAW[$id]:-0} ))
  done

  EXCL_TOTAL=$( bytesToHumanIEC "$EXCL_TOTAL" )

  printf "$separatorLine"
  printf "%s %66s\n" "Total exclusive data" "$EXCL_TOTAL"
}

if [ ${#SORT_OPTIONS[@]} -gt 0 ]; then
  for opt in "${SORT_OPTIONS[@]}"; do
    print_report "$opt"
  done
else
  print_report ""
fi

